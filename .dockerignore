# Keep the build context small and never ship secrets or generated data.
.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

.env
.env.*
!.env.example

data/upstream/*
data/landing/*
*.ndjson
pgdata/
logs/
*.log

docs/
tests/
*.md
!README.md
