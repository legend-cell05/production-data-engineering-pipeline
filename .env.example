# ---------------------------------------------------------------------------
# production-data-engineering-pipeline -- example configuration
#
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed. Nothing here is a real
# credential; the values below are local placeholders.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
# Inside Docker Compose this must be the service name (`postgres`).
HELIOS_DB_HOST=localhost
HELIOS_DB_PORT=5432
HELIOS_DB_NAME=helios
HELIOS_DB_USER=helios_app
HELIOS_DB_PASSWORD=change_me_local_only

HELIOS_RAW_SCHEMA=raw
HELIOS_CORE_SCHEMA=core
HELIOS_MART_SCHEMA=mart
HELIOS_META_SCHEMA=meta

# --- Upstream API ----------------------------------------------------------
# Base URL of the source system. In Compose: http://api:8000
HELIOS_API_BASE_URL=http://localhost:8000
HELIOS_API_PAGE_SIZE=5000
HELIOS_API_TIMEOUT_SECONDS=30

# Retry policy for transient upstream failures (429, 5xx, connection errors).
HELIOS_RETRY_MAX_ATTEMPTS=5
HELIOS_RETRY_BASE_DELAY_SECONDS=0.5
HELIOS_RETRY_MAX_DELAY_SECONDS=30.0

# Fault injection in the simulated source, for demonstrating the retry logic.
# Probability that a page request fails with a 503 before succeeding.
HELIOS_SOURCE_FAULT_RATE=0.15
# Probability that a page request is rate-limited (429 + Retry-After).
HELIOS_SOURCE_RATE_LIMIT_RATE=0.05

# --- Incremental ingestion -------------------------------------------------
# How far back to re-read on every run, to catch records that arrived late
# (a meter that was offline and back-filled its buffer). Costs a little
# re-reading; prevents silent data loss. See docs/incremental.md.
HELIOS_LATE_ARRIVAL_GRACE_MINUTES=90

# Rows per COPY batch when loading into the warehouse.
HELIOS_COPY_BATCH_SIZE=50000

# Dead-lettered records are retried at most this many times before being
# left for a human.
HELIOS_DLQ_MAX_ATTEMPTS=3

# --- Upstream data generation ----------------------------------------------
HELIOS_RANDOM_SEED=20260215
HELIOS_N_SITES=40
HELIOS_N_METERS=60
HELIOS_HISTORY_DAYS=30
HELIOS_INTERVAL_MINUTES=15
# Share of intervals deliberately missing (meter offline), and share of
# meters that roll over / reset during the period.
HELIOS_GAP_RATE=0.012
HELIOS_RESET_RATE=0.05

# --- Paths -----------------------------------------------------------------
HELIOS_DATA_DIR=data

# --- Runtime ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
HELIOS_LOG_LEVEL=INFO
# text | json
HELIOS_LOG_FORMAT=text
